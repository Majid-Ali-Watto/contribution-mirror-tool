# Your settings (.env). The `setup` command copies this template into your config folder (owner-only); fill in your
# own values there, or use the page (the `ui` command). Never commit it.
# The commands are `python3 -I src/mirror.py <command>` in a checkout, `contribution-mirror <command>` when installed.
# Format: KEY=VALUE, one per line. Comments on their own line. No inline comments.

# Your author email in the WORK repos. Several emails: separate them with spaces.
WORK_EMAIL=you@company.com

# Identity of the mirror commits. The email must be VERIFIED on your PERSONAL GitHub account,
# otherwise the commits will not show on your graph.
PERSONAL_NAME=Your Name
PERSONAL_EMAIL=you@example.com

# Local folder of the mirror repo (created if missing).
MIRROR_DIR=~/work-contributions

# Remote of the mirror repo. sync refuses to push to any other repo. Any URL form works (ssh or https):
# only owner/repo is compared, so https://github.com/your-user/work-contributions is equivalent.
EXPECTED_REMOTE=git@github.com:your-user/work-contributions.git

# ---------------------------------------------------------------------------------------------------------
# Everything below is OPTIONAL and normally not needed. Authentication is automatic: git uses your own ssh
# keys or https credential helper, and PRs/reviews use a login found on your machine (see docs/authentication.md).
# ---------------------------------------------------------------------------------------------------------

# Force one login instead of the automatic choice (a token with read access to pull requests and repository
# metadata; authorize it for SSO if your organisation uses it). Keep this file private (it is created owner-only).
#   any host whose kind is known (public hosts, and servers named in GIT_HOST_PROVIDERS below):
WORK_TOKEN=
#   or per host:
WORK_GITHUB_TOKEN=
WORK_GITLAB_TOKEN=
WORK_BITBUCKET_TOKEN=
WORK_AZURE_DEVOPS_TOKEN=
WORK_GITEA_TOKEN=
#   GitHub only: the name of your work account in the gh CLI (useful if several accounts are logged in).
WORK_GH_USER=
# Self-hosted servers: tell the tool what each one is, and where its API is if not at the usual place.
#   e.g. GIT_HOST_PROVIDERS=git.corp.com=gitlab,code.corp.com=gitea
GIT_HOST_PROVIDERS=
#   e.g. WORK_GITHUB_API_URL=https://github.example.com/api/v3  (also WORK_GITLAB_API_URL, WORK_BITBUCKET_API_URL,
#   WORK_AZURE_DEVOPS_API_URL, WORK_GITEA_API_URL)
WORK_GITHUB_API_URL=
# Only mirror dates on or after / on or before a day (YYYY-MM-DD), e.g. when you joined or left. Empty: no limit.
# Dates already in the mirror are never removed.
MIRROR_SINCE=
MIRROR_UNTIL=
# Set to `off` to mirror commits only (no PRs/reviews).
MIRROR_PR_REVIEWS=
# Where mirror.log, api-state.json and the temporary clones go (default: the `setup` command shows it).
MIRROR_LOG_DIR=
# Keep the clones of URL entries in this folder between runs and only fetch new commits (faster for long histories).
# Default: empty = temporary clones, deleted after each run. The folder holds those repos' commit metadata: keep it private.
MIRROR_CLONE_CACHE=

# Optional: SSH key used ONLY for pushing to your personal mirror (handy for unattended runs without an
# ssh-agent). Leave empty to use your normal git setup, which is right for https remotes with a credential
# helper and for ssh with your default key or agent.
PERSONAL_SSH_KEY=
